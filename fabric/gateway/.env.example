# OncoVault Trusted Fabric Gateway Configuration
# Copy to .env for local runtime execution

# Server Configuration (Strictly Loopback Only)
HOST=127.0.0.1
PORT=5001
NODE_ENV=development

# Fabric Peer & Network Connectivity
FABRIC_CHANNEL_NAME=oncovault-channel
FABRIC_CHAINCODE_NAME=oncovault
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_OVERRIDE=peer0.org1.example.com

# Fabric Gateway Client Credentials (WSL2 paths outside Git)
FABRIC_TLS_CERT_PATH=/home/oncovault/oncovault-fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/tlsca/tlsca.org1.example.com-cert.pem
FABRIC_GATEWAY_CERT_PATH=/home/oncovault/oncovault-fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/oncovault-gateway@org1.example.com/msp/signcerts/cert.pem
FABRIC_GATEWAY_KEY_DIR=/home/oncovault/oncovault-fabric/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/oncovault-gateway@org1.example.com/msp/keystore

# Pseudonymization Server Secret (32+ character protected secret for HMAC-SHA256)
PSEUDONYM_HMAC_SECRET=replace_with_a_secure_random_32_byte_secret_for_domain_separation

# Live Consent Mutation Safety Gate (Phase 2: Keep disabled until Flutter/Firestore migration in Phase 3)
ENABLE_LIVE_CONSENT_MUTATIONS=false

# Periodic clinical-note/treatment proof projection recovery (default: true).
# Recovery cannot submit new Fabric transactions: authoritative automatic-write
# approval is not defined by the current schema. Missing/uncertain proofs stay blocked.
# Keep false until separately approved; consent safety and explicit recovery remain available.
ENABLE_BACKGROUND_ANCHORING=true

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=oncovault-8cbbc
FIREBASE_STORAGE_BUCKET=oncovault-8cbbc.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_PATH=
