rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roleName) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == roleName;
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isNurse() {
      return hasRole('nurse');
    }

    function isPatient() {
      return hasRole('patient');
    }

    function isTerminalStatus(status) {
      return status.matches('(?i)^(completed|rejected|cancelled|canceled)$');
    }

    function isValidAppointmentPayload(data, appointmentId) {
      return data.id == appointmentId &&
        data.patientId == request.auth.uid &&
        data.doctorId is string && data.doctorId.size() > 0 &&
        data.doctorName is string && data.doctorName.size() > 0 &&
        data.doctorSpecialty is string &&
        data.appointmentDate is timestamp &&
        data.timeSlot is string && data.timeSlot.size() > 0 &&
        data.status == 'scheduled' &&
        data.createdAt is timestamp;
    }

    // NOTE ON CLINICIAN ACCESS (Phase 1 Access Model):
    // `isClinician()` currently provides broad clinical read access to patient
    // records because of the existing hospital nurse workflow (where on-duty nurses
    // triage arriving patients across all doctors via approved appointment queues)
    // and because appointment documents have non-deterministic IDs that cannot be
    // queried dynamically within Firestore security rules.
    //
    // This is a temporary Phase 1 Role-Based Access Control (RBAC) baseline.
    // It is NOT yet relationship-based or consent-based access control (ABAC).
    // Doctor-patient relationship/consent enforcement is a planned future enhancement
    // once deterministic consent records and appointment links are active in the UI.
    //
    // SECURITY GUARANTEE: Patients can NEVER access another patient's clinical data
    // under these rules. Only verified clinicians (doctors and nurses) have care delivery access.
    function isClinician() {
      return isDoctor() || isNurse();
    }

    function hasActiveNurseAssignment(patientId) {
      return isNurse() &&
        exists(/databases/$(database)/documents/nurse_patient_assignments/$(request.auth.uid + '_' + patientId)) &&
        get(/databases/$(database)/documents/nurse_patient_assignments/$(request.auth.uid + '_' + patientId)).data.status == 'active';
    }

    function canAccessPatientVitals(patientId) {
      return isAuthenticated() && (
        isOwner(patientId) ||
        isDoctor() ||
        hasRole('admin') ||
        hasActiveNurseAssignment(patientId)
      );
    }

    function canDoctorAccessPatientEhr(patientId) {
      return isDoctor() && (
        // Care relationship via active granted consent
        (
          exists(/databases/$(database)/documents/doctor_patient_consents/$(patientId + '_' + request.auth.uid)) &&
          get(/databases/$(database)/documents/doctor_patient_consents/$(patientId + '_' + request.auth.uid)).data.status == 'granted'
        ) ||
        // Care relationship via matching hospital between doctor and patient in users collection
        (
          ('hospitalId' in getUserData()) &&
          exists(/databases/$(database)/documents/users/$(patientId)) &&
          ('hospitalId' in get(/databases/$(database)/documents/users/$(patientId)).data) &&
          getUserData().hospitalId is string &&
          getUserData().hospitalId == get(/databases/$(database)/documents/users/$(patientId)).data.hospitalId
        ) ||
        // Care relationship via matching hospital in patients collection
        (
          ('hospitalId' in getUserData()) &&
          exists(/databases/$(database)/documents/patients/$(patientId)) &&
          ('hospitalId' in get(/databases/$(database)/documents/patients/$(patientId)).data) &&
          getUserData().hospitalId is string &&
          getUserData().hospitalId == get(/databases/$(database)/documents/patients/$(patientId)).data.hospitalId
        )
      );
    }

    function canAccessTreatmentPlan(patientId) {
      return isAuthenticated() && (
        isOwner(patientId) ||
        hasRole('admin') ||
        hasActiveNurseAssignment(patientId) ||
        canDoctorAccessPatientEhr(patientId)
      );
    }

    // =========================================================================
    // 1. MEDICAL ID DIRECTORY (Pre-auth lookup)
    // =========================================================================
    // Only exact single-document get() allowed to resolve email prior to signIn.
    // Listing/scraping the directory is strictly forbidden.
    match /medical_id_directory/{medicalId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // =========================================================================
    // 2. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      // Clinicians can fetch a specific patient profile; users can fetch their own.
      // Listing the entire collection is blocked.
      allow get: if isAuthenticated() && (isOwner(userId) || isClinician());
      allow list: if false;

      // Self-registration can ONLY create 'patient' accounts.
      // Clinicians and Admins must be provisioned by an Admin.
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == 'patient') ||
        hasRole('admin')
      );

      // Users can update profile fields, but NEVER change their role
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) ||
        hasRole('admin')
      );

      allow delete: if false;

      // Subcollection: Device Tokens (Phase 1B FCM Infrastructure)
      match /deviceTokens/{tokenId} {
        allow read, create, update, delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // =========================================================================
    // 3. PATIENTS COLLECTION & SUBCOLLECTIONS
    // =========================================================================
    match /patients/{patientId} {
      allow get: if isAuthenticated() && (isOwner(patientId) || isClinician());
      allow list: if isAuthenticated() && isClinician();
      allow create, update: if isAuthenticated() && (isOwner(patientId) || isClinician());
      allow delete: if false;

      // Subcollection: Appointments mirror
      match /appointments/{appointmentId} {
        allow read: if isAuthenticated() && (isOwner(patientId) || isClinician());

        allow create: if isAuthenticated() &&
          isOwner(patientId) &&
          request.resource.data.patientId == patientId &&
          isValidAppointmentPayload(request.resource.data, appointmentId) &&
          !exists(/databases/$(database)/documents/appointments/$(appointmentId)) &&
          !exists(/databases/$(database)/documents/patients/$(patientId)/appointments/$(appointmentId)) &&
          existsAfter(/databases/$(database)/documents/appointments/$(appointmentId)) &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.id == appointmentId &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.patientId == patientId &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.doctorId == request.resource.data.doctorId &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.status == request.resource.data.status &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.appointmentDate == request.resource.data.appointmentDate &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.timeSlot == request.resource.data.timeSlot;

        allow update: if isAuthenticated() &&
          !isTerminalStatus(resource.data.status) &&
          !request.resource.data.status.matches('(?i)^(confirmed|approved)$') &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.patientId == resource.data.patientId &&
          request.resource.data.doctorId == resource.data.doctorId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          existsAfter(/databases/$(database)/documents/appointments/$(appointmentId)) &&
          getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.status == request.resource.data.status &&
          (
            // Cancellation (Patient or Doctor)
            (
              ((isOwner(patientId) && isPatient()) || (isOwner(resource.data.doctorId) && isDoctor())) &&
              resource.data.status.matches('(?i)^(scheduled|pending|rescheduled|confirmed|approved)$') &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.appointmentDate == resource.data.appointmentDate &&
              request.resource.data.timeSlot == resource.data.timeSlot
            ) ||
            // Rescheduling (Patient or Doctor)
            (
              ((isOwner(patientId) && isPatient()) || (isOwner(resource.data.doctorId) && isDoctor())) &&
              resource.data.status.matches('(?i)^(scheduled|pending|rescheduled|confirmed|approved)$') &&
              request.resource.data.status == 'scheduled' &&
              request.resource.data.appointmentDate is timestamp &&
              request.resource.data.timeSlot is string && request.resource.data.timeSlot.size() > 0 &&
              getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.appointmentDate == request.resource.data.appointmentDate &&
              getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data.timeSlot == request.resource.data.timeSlot
            ) ||
            // Rejection (Doctor only)
            (
              isOwner(resource.data.doctorId) && isDoctor() &&
              resource.data.status.matches('(?i)^(scheduled|pending|rescheduled)$') &&
              request.resource.data.status == 'rejected' &&
              request.resource.data.appointmentDate == resource.data.appointmentDate &&
              request.resource.data.timeSlot == resource.data.timeSlot
            ) ||
            // Completion (Doctor only)
            (
              isOwner(resource.data.doctorId) && isDoctor() &&
              resource.data.status.matches('(?i)^(confirmed|approved)$') &&
              request.resource.data.status == 'completed' &&
              request.resource.data.appointmentDate == resource.data.appointmentDate &&
              request.resource.data.timeSlot == resource.data.timeSlot
            )
          );

        allow delete: if false;
      }

      // Subcollection: Blood Cancer EHRs
      match /blood_cancer_ehrs/{recordId} {
        allow read: if isAuthenticated() && (isOwner(patientId) || isClinician());
        allow create: if isAuthenticated() &&
          canDoctorAccessPatientEhr(patientId) &&
          ('patientId' in request.resource.data) &&
          request.resource.data.patientId is string &&
          request.resource.data.patientId == patientId;
        allow update: if isAuthenticated() &&
          canDoctorAccessPatientEhr(patientId) &&
          (!('patientId' in request.resource.data) || request.resource.data.patientId == resource.data.patientId) &&
          (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isAuthenticated() && canDoctorAccessPatientEhr(patientId);
      }

      // Subcollection: Diagnoses
      match /diagnoses/{diagnosisId} {
        allow read: if isAuthenticated() && (isOwner(patientId) || isClinician());
        allow create, update, delete: if isAuthenticated() && isDoctor();
      }

      // Subcollection: Medical Records
      match /medicalRecords/{recordId} {
        allow read: if isAuthenticated() && (isOwner(patientId) || isClinician());
        allow create: if isAuthenticated() && (isOwner(patientId) || isClinician()) &&
          (!('uploadedBy' in request.resource.data) || request.resource.data.uploadedBy == request.auth.uid) &&
          !request.resource.data.keys().hasAny(['fabricStatus', 'fabricTxId', 'fabricVersion', 'fabricTimestamp', 'opaqueRecordKey', 'blockchainProof']);
        allow update: if isAuthenticated() && (isOwner(patientId) || isClinician()) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uploadedBy', 'fabricStatus', 'fabricTxId', 'fabricVersion', 'fabricTimestamp', 'opaqueRecordKey', 'blockchainProof']);
        allow delete: if isAuthenticated() && (isOwner(patientId) || isDoctor());
      }

      // Subcollection: Clinical Notes (Phase 3C Voice Documentation)
      match /clinical_notes/{noteId} {
        // Direct client writes strictly blocked — trusted Cloud Functions only
        allow write: if false;

        // Reads permitted for:
        // - Patient themselves
        // - Attending doctor
        // - Hospital admin
        // - Actively assigned nurse
        allow read: if isAuthenticated() && canAccessPatientVitals(patientId);
      }

      // Subcollection: Treatment Plans (Phase 3D Treatment Progress Tracking)
      match /treatment_plans/{planId} {
        // Direct client writes strictly blocked — mutations must route through trusted Cloud Functions
        allow write: if false;

        // Reads permitted for:
        // - Patient themselves
        // - Attending doctor with care relationship / granted consent / matching hospital
        // - Hospital admin
        // - Actively assigned nurse
        // Cross-hospital and unassigned clinicians are strictly blocked.
        allow read: if canAccessTreatmentPlan(patientId);

        // Subcollection: Treatment Tasks
        match /tasks/{taskId} {
          allow write: if false;
          allow read: if canAccessTreatmentPlan(patientId);
        }

        // Subcollection: Treatment Progress Updates
        match /progress_updates/{updateId} {
          allow write: if false;
          allow read: if canAccessTreatmentPlan(patientId);
        }
      }
    }

    // =========================================================================
    // 4. DOCTORS COLLECTION & SUBCOLLECTIONS
    // =========================================================================
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      // Doctor can update profile, but cannot tamper with backend coordination scheduleRevision
      // or directly alter availability or legacy slot configurations without going through trusted Cloud Function validation
      allow create: if isAuthenticated() && isOwner(doctorId) && isDoctor() &&
        (!request.resource.data.keys().hasAny(['scheduleRevision', 'availability', 'availableDays', 'availableSlots']) || request.resource.data.scheduleRevision == 0);
      allow update: if isAuthenticated() && isOwner(doctorId) && isDoctor() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['scheduleRevision']) ||
         request.resource.data.scheduleRevision == resource.data.scheduleRevision) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['availability']) ||
         request.resource.data.availability == resource.data.availability) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['availableDays']) ||
         request.resource.data.availableDays == resource.data.availableDays) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['availableSlots']) ||
         request.resource.data.availableSlots == resource.data.availableSlots);
      allow delete: if false;

      // Subcollection: Doctor Critical Alerts
      match /alerts/{alertId} {
        allow read: if isAuthenticated() && (isOwner(doctorId) || hasRole('admin'));
        // Direct client creation is blocked to prevent forgery; vital alerts originate from trusted backend
        allow create: if false;
        // Direct client mutation of clinical state is blocked; only isRead may be toggled locally
        allow update: if isAuthenticated() && isOwner(doctorId) && isDoctor() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if false;
      }

      // Subcollection: Doctor Diagnoses Index
      match /diagnoses/{diagnosisId} {
        allow read, create, update, delete: if isAuthenticated() &&
          isOwner(doctorId) && isDoctor();
      }
    }

    // =========================================================================
    // 5. NURSES COLLECTION & SUBCOLLECTIONS
    // =========================================================================
    match /nurses/{nurseId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(nurseId) && isNurse();
      allow delete: if false;

      // Subcollection: Daily vitals recording statistics (FR-NHO.2)
      match /daily_stats/{dateKey} {
        allow read: if isAuthenticated() && (isOwner(nurseId) || hasRole('admin'));
        allow create, update: if isAuthenticated() && ((isOwner(nurseId) && isNurse()) || hasRole('admin'));
        allow delete: if false;
      }

      // Subcollection: Reports uploaded tracking (FR-NHO.3)
      match /reports_uploaded/{reportId} {
        allow read: if isAuthenticated() && (isOwner(nurseId) || hasRole('admin'));
        // Prevent artificial metric inflation & claiming other clinicians' uploads:
        // A nurse can only record an uploaded report attribution if:
        // 1. The nurse is active and owns the record
        // 2. The target patient is specified and matches reportId
        // 3. The nurse has an active care assignment for that patient
        // 4. The underlying medical record exists in Firestore (top-level or patient subcollection)
        // 5. Authoritative uploader attribution: The underlying record must explicitly attribute
        //    the upload to this nurse (uploadedBy == request.auth.uid) AND match patientId
        allow create: if isAuthenticated() &&
          isOwner(nurseId) && isNurse() &&
          request.resource.data.patientId is string &&
          request.resource.data.reportId == reportId &&
          hasActiveNurseAssignment(request.resource.data.patientId) &&
          (
            (
              exists(/databases/$(database)/documents/medical_records/$(reportId)) &&
              get(/databases/$(database)/documents/medical_records/$(reportId)).data.patientId == request.resource.data.patientId &&
              get(/databases/$(database)/documents/medical_records/$(reportId)).data.uploadedBy == request.auth.uid
            ) ||
            (
              exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/medicalRecords/$(reportId)) &&
              get(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/medicalRecords/$(reportId)).data.uploadedBy == request.auth.uid
            )
          );
        allow update, delete: if false;
      }
    }

    // =========================================================================
    // 5B. NURSE-PATIENT ASSIGNMENTS (Phase 3A Authorized Care Relationship)
    // =========================================================================
    match /nurse_patient_assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.nurseId ||
        request.auth.uid == resource.data.patientId ||
        isDoctor() ||
        hasRole('admin')
      );
      // Direct client writes strictly forbidden: all assignments and revocations
      // must route through trusted Cloud Functions (assignNurse / revokeNurseAssignment) via Admin SDK.
      allow write: if false;
    }

    // =========================================================================
    // 6. BOOKED SLOTS COLLECTION
    // =========================================================================
    match /bookedSlots/{doctorId}/slots/{slotKey} {
      allow read: if isAuthenticated();
      // Exclusive locks are written strictly by trusted Cloud Function via Admin SDK
      allow create, update: if false;

      // Deletion is coupled strictly with verified appointment cancellation or rescheduling
      allow delete: if isAuthenticated() &&
        (isOwner(doctorId) || resource.data.patientId == request.auth.uid) &&
        resource.data.appointmentId is string &&
        exists(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)) &&
        get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status.matches('(?i)^(confirmed|approved)$') &&
        getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status.matches('(?i)^(cancelled|scheduled)$') &&
        get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.doctorId == doctorId &&
        get(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.patientId == resource.data.patientId;
    }

    // =========================================================================
    // 7. NOTIFICATIONS COLLECTION & SUBCOLLECTION
    // =========================================================================
    match /notifications/{userId}/items/{notificationId} {
      allow read: if isAuthenticated() && isOwner(userId);
      // Only the user themselves or an authorized clinician can create a notification
      allow create: if isAuthenticated() && (
        isOwner(userId) ||
        isClinician()
      );
      allow update, delete: if isAuthenticated() && isOwner(userId);
    }

    // =========================================================================
    // 8. DOCTOR-PATIENT CONSENT COLLECTION
    // =========================================================================
    match /doctor_patient_consents/{consentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isClinician()
      );
      // Direct client writes strictly disabled: all mutations must route through Trusted Fabric Gateway
      // and are synchronized to Firestore exclusively via server-side Firebase Admin SDK.
      allow write: if false;
    }

    // =========================================================================
    // 9. EHR VITALS COLLECTION & OBSERVATIONS SUBCOLLECTION
    // =========================================================================
    match /ehr_vitals/{patientId} {
      // Read access requires patient ownership, doctor role, admin, or active nurse assignment
      allow read: if canAccessPatientVitals(patientId);

      // Direct client writes strictly forbidden: all vital observations and latest cache
      // updates must route through the authoritative Cloud Function recordVitalObservation via Admin SDK.
      allow write: if false;

      // Subcollection: Immutable Historical Observations (Phase 3A)
      match /observations/{observationId} {
        // Read observations requires the same authorization check as parent
        allow read: if canAccessPatientVitals(patientId);

        // Direct client writes strictly forbidden: callable function is authoritative write path
        allow write: if false;
      }
    }

    // =========================================================================
    // 10. GLOBAL MEDICAL RECORDS COLLECTION
    // =========================================================================
    match /medical_records/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isClinician()
      );
      allow create: if isAuthenticated() && (
        (isPatient() && request.resource.data.patientId == request.auth.uid) ||
        isClinician()
      ) &&
      (!('uploadedBy' in request.resource.data) || request.resource.data.uploadedBy == request.auth.uid) &&
      !request.resource.data.keys().hasAny(['fabricStatus', 'fabricTxId', 'fabricVersion', 'fabricTimestamp', 'opaqueRecordKey', 'blockchainProof']);
      allow update: if isAuthenticated() && (
        (resource.data.patientId == request.auth.uid && request.resource.data.patientId == request.auth.uid) ||
        isClinician()
      ) &&
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uploadedBy', 'fabricStatus', 'fabricTxId', 'fabricVersion', 'fabricTimestamp', 'opaqueRecordKey', 'blockchainProof']);
      allow delete: if isAuthenticated() && isDoctor();
    }

    // =========================================================================
    // 10B. GATEWAY DURABLE OPERATIONS COLLECTION
    // =========================================================================
    match /gateway_operations/{operationId} {
      // Internal backend reconciliation metadata: clients are strictly denied read and write access
      allow read, write: if false;
    }

    // =========================================================================
    // 11. GLOBAL APPOINTMENTS COLLECTION
    // =========================================================================
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isClinician()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.patientId == request.auth.uid &&
        isValidAppointmentPayload(request.resource.data, appointmentId) &&
        !exists(/databases/$(database)/documents/appointments/$(appointmentId)) &&
        !exists(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)) &&
        existsAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)) &&
        getAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)).data.id == appointmentId &&
        getAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)).data.patientId == request.resource.data.patientId &&
        getAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)).data.doctorId == request.resource.data.doctorId &&
        getAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)).data.status == request.resource.data.status &&
        getAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)).data.appointmentDate == request.resource.data.appointmentDate &&
        getAfter(/databases/$(database)/documents/patients/$(request.resource.data.patientId)/appointments/$(appointmentId)).data.timeSlot == request.resource.data.timeSlot;

      allow update: if isAuthenticated() &&
        !isTerminalStatus(resource.data.status) &&
        !request.resource.data.status.matches('(?i)^(confirmed|approved)$') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.doctorId == resource.data.doctorId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        existsAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)/appointments/$(appointmentId)) &&
        getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)/appointments/$(appointmentId)).data.status == request.resource.data.status &&
        (
          // Cancellation (Patient or Doctor)
          (
            ((isOwner(resource.data.patientId) && isPatient()) || (isOwner(resource.data.doctorId) && isDoctor())) &&
            resource.data.status.matches('(?i)^(scheduled|pending|rescheduled|confirmed|approved)$') &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.appointmentDate == resource.data.appointmentDate &&
            request.resource.data.timeSlot == resource.data.timeSlot
          ) ||
          // Rescheduling (Patient or Doctor)
          (
            ((isOwner(resource.data.patientId) && isPatient()) || (isOwner(resource.data.doctorId) && isDoctor())) &&
            resource.data.status.matches('(?i)^(scheduled|pending|rescheduled|confirmed|approved)$') &&
            request.resource.data.status == 'scheduled' &&
            request.resource.data.appointmentDate is timestamp &&
            request.resource.data.timeSlot is string && request.resource.data.timeSlot.size() > 0 &&
            getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)/appointments/$(appointmentId)).data.appointmentDate == request.resource.data.appointmentDate &&
            getAfter(/databases/$(database)/documents/patients/$(resource.data.patientId)/appointments/$(appointmentId)).data.timeSlot == request.resource.data.timeSlot
          ) ||
          // Rejection (Doctor only)
          (
            isOwner(resource.data.doctorId) && isDoctor() &&
            resource.data.status.matches('(?i)^(scheduled|pending|rescheduled)$') &&
            request.resource.data.status == 'rejected' &&
            request.resource.data.appointmentDate == resource.data.appointmentDate &&
            request.resource.data.timeSlot == resource.data.timeSlot
          ) ||
          // Completion (Doctor only)
          (
            isOwner(resource.data.doctorId) && isDoctor() &&
            resource.data.status.matches('(?i)^(confirmed|approved)$') &&
            request.resource.data.status == 'completed' &&
            request.resource.data.appointmentDate == resource.data.appointmentDate &&
            request.resource.data.timeSlot == resource.data.timeSlot
          )
        );

      allow delete: if false;
    }

    // =========================================================================
    // 12. GLOBAL PRESCRIPTIONS COLLECTION
    // =========================================================================
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        resource.data.doctorId == request.auth.uid ||
        isClinician()
      );
      // Strictly enforced: Only the prescribing doctor can create with their own doctorId
      allow create: if isAuthenticated() &&
        isDoctor() &&
        request.resource.data.doctorId == request.auth.uid;
      allow update, delete: if isAuthenticated() &&
        isDoctor() &&
        resource.data.doctorId == request.auth.uid;
    }

    // =========================================================================
    // 13. CRITICAL ALERT EVENTS (TRUSTED WORKER PIPELINE)
    // =========================================================================
    match /critical_alert_events/{eventId} {
      // Direct client access is strictly denied; accessed exclusively via Firebase Admin SDK
      allow read, write: if false;
    }

    // =========================================================================
    // 14. SUPERVISOR ESCALATED ALERTS
    // =========================================================================
    match /escalated_alerts/{escalationId} {
      // Direct client write/mutation is strictly blocked (Admin SDK pipeline only)
      allow write: if false;

      // Hospital-scoped authorization:
      // 1. Hospital admin for the specific hospital
      // 2. Doctor assigned to alert or with active granted Fabric consent in same hospital
      // 3. Nurse actively assigned to patient in same hospital
      // Cross-hospital access and unassigned clinicians are strictly blocked.
      allow read: if isAuthenticated() && (
        (hasRole('admin') && getUserData().hospitalId == resource.data.hospitalId) ||
        (
          isClinician() &&
          getUserData().hospitalId == resource.data.hospitalId &&
          (
            hasActiveNurseAssignment(resource.data.patientId) ||
            (
              isDoctor() && (
                resource.data.doctorId == request.auth.uid ||
                (
                  exists(/databases/$(database)/documents/doctor_patient_consents/$(resource.data.patientId + '_' + request.auth.uid)) &&
                  get(/databases/$(database)/documents/doctor_patient_consents/$(resource.data.patientId + '_' + request.auth.uid)).data.status == 'granted'
                )
              )
            )
          )
        )
      );
    }

    // =========================================================================
    // DEFAULT CATCH-ALL: Deny all unauthenticated or undeclared collection access
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
