rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{uid}/{fileName} {
      // Patient reads own uploaded report files; clinicians read patient reports
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['doctor', 'nurse']
      );

      // Only patient uploading to own directory or a clinician can write reports (max 50MB)
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['doctor', 'nurse']
      ) && request.resource.size < 50 * 1024 * 1024;

      // Only owner or doctor can delete reports
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'doctor'
      );
    }

    // Explicit catch-all: Deny all other Storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
